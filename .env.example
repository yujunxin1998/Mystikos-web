# 服务端代理的 Mystikos 后端地址。不要在地址末尾添加 /api/v1。
NUXT_MYSTIKOS_API_BASE=https://www.joinmystikos.com

# 密码登录 RSA 非对称加密开关。默认值见 config/security.config.ts，此处可覆盖。
# 设为 false 时密码按明文提交，仅用于后端同样关闭非对称加密的联调 / 测试环境。
NUXT_PUBLIC_PASSWORD_ENCRYPTION_ENABLED=true

# Discord OAuth 现由后端发起并处理回调；前端不保存 Client Secret、state 或 PKCE verifier。
# 后端的 DISCORD_REDIRECT_URI 必须登记到 Discord Developer Portal。

# Nuxt Node 服务监听地址与端口。
HOST=127.0.0.1
PORT=3000

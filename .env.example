# 服务端代理的 Mystikos 后端地址。不要在地址末尾添加 /api/v1。
NUXT_MYSTIKOS_API_BASE=http://116.62.218.227:8099

# Discord OAuth 配置。Redirect URI 必须同时配置到 Discord Developer Portal 和后端。
# 本地开发建议：http://127.0.0.1:3000/auth
NUXT_PUBLIC_DISCORD_CLIENT_ID=
NUXT_PUBLIC_DISCORD_REDIRECT_URI=
# 如由网关统一生成完整授权地址，可改用该变量覆盖自动生成的 URL。
NUXT_PUBLIC_DISCORD_AUTHORIZE_URL=

# Nuxt Node 服务监听地址与端口。
HOST=127.0.0.1
PORT=3000
